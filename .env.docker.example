# Docker environment variables for docker-compose.yml
# Copy this file: copy .env.docker.example .env.docker
# Then fill in real values.

# ── SERVER ──
PORT=4000
NODE_ENV=production

# ── DATABASE ──
# Use the service name "mongo" as the hostname (Docker networking)
MONGODB_URI=mongodb://mongo:27017/media-processing-app

# ── REDIS ──
# Use the service name "redis" as the hostname
REDIS_HOST=redis
REDIS_PORT=6379

# ── MINIO / STORAGE ──
# Use the service name "minio" as the hostname
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media
MINIO_USE_SSL=false

# ── AUTH ──
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# ── EMAIL (Resend) ──
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Media Processing Service <onboarding@resend.dev>

# ── FRONTEND ──
CLIENT_URL=http://localhost:3000

# ── CORS ──
CORS_ORIGIN=http://localhost:3000

# ── CHAOS TESTING ──
CHAOS_ENABLED=false

# ── UPLOAD LIMITS ──
MAX_FILE_SIZE=104857600
