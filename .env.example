# ── SERVER ──
PORT=4000
NODE_ENV=development

# ── DATABASE ──
MONGODB_URI=mongodb://localhost:27017/media-processing-app

# ── REDIS ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── MINIO / STORAGE ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media
MINIO_USE_SSL=false

# ── AUTH ──
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# ── EMAIL (Resend) ──
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Media Processing Service <onboarding@resend.dev>"

# ── FRONTEND (public) ──
CLIENT_URL=http://localhost:5173

# ── CORS ──
CORS_ORIGIN=http://localhost:5173

# ── CHAOS TESTING ──
CHAOS_ENABLED=false
CHAOS_PROBABILITY=0.3

# ── UPLOAD LIMITS ──
MAX_FILE_SIZE=104857600
